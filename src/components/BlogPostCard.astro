---
import type { BlogPostListItem } from '../lib/blog-posts';

interface Props {
  post: BlogPostListItem;
}

const PLACEHOLDER = '/images/blog-placeholder.svg';

const { post } = Astro.props;
const readMoreLabel = `Lees meer over ${post.title}`;
const imageSrc = post.image || PLACEHOLDER;
const isPlaceholder = !post.image;
---

<article
  class="elementor-post elementor-grid-item post type-post status-publish format-standard hentry category-blog dgg-blog-card has-post-thumbnail"
  role="listitem"
>
  <a class="elementor-post__thumbnail__link" href={post.url} tabindex="-1">
    <div
      class:list={[
        'elementor-post__thumbnail',
        { 'elementor-post__thumbnail--placeholder': isPlaceholder },
      ]}
    >
      <img
        width="400"
        height="264"
        src={imageSrc}
        class="attachment-medium size-medium wp-post-image"
        alt=""
        loading="lazy"
        data-placeholder={PLACEHOLDER}
      />
    </div>
  </a>
  <div class="elementor-post__text">
    <p class="elementor-post__title">
      <a href={post.url}>{post.title}</a>
    </p>
    <div class="elementor-post__meta-data">
      <span class="elementor-post-date">{post.date}</span>
    </div>
    <a
      class="elementor-post__read-more"
      href={post.url}
      aria-label={readMoreLabel}
      tabindex="-1"
    >
      Lees verder »
    </a>
  </div>
</article>
