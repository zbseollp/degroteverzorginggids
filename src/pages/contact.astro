---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import headerHtml from '../data/contact/header.html?raw';
import mainHtml from '../data/contact/main.html?raw';
import footerHtml from '../data/contact/footer.html?raw';
import meta from '../data/contact/meta.json';

const { title, description, canonical, bodyClass, modifiedTime, publishedTime, postCss } = meta;
---

<ContentPageLayout
  title={title}
  description={description}
  canonical={canonical}
  bodyClass={bodyClass}
  modifiedTime={modifiedTime}
  publishedTime={publishedTime}
  postCss={postCss}
>
  <Fragment set:html={headerHtml} />
  <Fragment set:html={mainHtml} />
  <Fragment set:html={footerHtml} />
</ContentPageLayout>
