---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import headerHtml from '../../data/blog-listing/header.html?raw';
import footerHtml from '../../data/blog-listing/footer.html?raw';
import meta from '../../data/blog-listing/meta.json';
import { getPublishedPosts, publicHref } from '../../lib/blog-posts';
import { stripMaliciousHtml } from '../../lib/sanitize-html';

const posts = await getPublishedPosts();
---

<ContentPageLayout
  title={`${meta.title} - degroteverzorginggids.nl`}
  description={meta.description}
  canonical="/blog/"
  modifiedTime={meta.modifiedTime}
  bodyClass={meta.bodyClass}
  postCss={meta.postCss}
  fixCss="/css/blog-listing-fixes.css"
  extraStylesheets={['/css/elementor/post-708.css']}
  pageScript="/js/blog-listing.js"
>
  <Fragment set:html={stripMaliciousHtml(headerHtml)} />
  <section class="blog-listing page-content">
    <h1>Laatste artikelen</h1>
    <ul class="blog-list">
      {posts.map((post) => (
        <li class="blog-list-item">
          <h2>
            <a href={publicHref(post)}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('nl-NL', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </li>
      ))}
    </ul>
  </section>
  <Fragment set:html={stripMaliciousHtml(footerHtml)} />
</ContentPageLayout>
