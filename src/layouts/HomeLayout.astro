---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  bodyClass?: string;
  modifiedTime?: string;
}

const props = Astro.props;
---

<PageLayout {...props} canonical={props.canonical ?? '/'} extraStylesheets={['/css/homepage-inline.css']}>
  <slot />
  <script src="/js/elementor-counters.js" defer></script>
</PageLayout>
