---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  bodyClass: string;
  modifiedTime?: string;
  publishedTime?: string;
  postCss?: string;
}

const props = Astro.props;
---

<PageLayout {...props} extraStylesheets={['/css/blog-post-fixes.css']}>
  <slot />
  <script src="/js/blog-post.js" defer></script>
</PageLayout>
