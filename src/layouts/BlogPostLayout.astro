---
import PageLayout from './PageLayout.astro';
import headerHtml from '../data/homepage/header.html?raw';
import footerHtml from '../data/homepage/footer.html?raw';
import { stripMaliciousHtml } from '../lib/sanitize-html';
import { blogBodyHtml, publicHref, type BlogPost } from '../lib/blog-posts';

interface Props {
  entry: BlogPost;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, author, categories, tags } = entry.data;
const canonical = publicHref(entry);
const bodyHtml = stripMaliciousHtml(blogBodyHtml(entry.body));
---

<PageLayout
  title={`${title} - degroteverzorginggids.nl`}
  description={description}
  canonical={canonical}
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  extraStylesheets={['/css/blog-post-fixes.css']}
>
  <Fragment set:html={stripMaliciousHtml(headerHtml)} />
  <article class="blog-post page-content">
    <header class="blog-post-header">
      <h1>{title}</h1>
      <div class="blog-post-meta">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {author && <span class="author">door {author}</span>}
        {updatedDate && (
          <span class="updated">
            (bijgewerkt: {updatedDate.toLocaleDateString('nl-NL')})
          </span>
        )}
      </div>
      {categories && categories.length > 0 && (
        <div class="blog-post-categories">
          {categories.map((cat) => (
            <span class="category-tag">{cat}</span>
          ))}
        </div>
      )}
    </header>
    <div class="blog-post-content" set:html={bodyHtml} />
    {tags && tags.length > 0 && (
      <footer class="blog-post-tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </footer>
    )}
  </article>
  <Fragment set:html={stripMaliciousHtml(footerHtml)} />
  <script src="/js/blog-post.js" defer></script>
</PageLayout>
