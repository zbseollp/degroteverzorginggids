---
import Favicon from '../components/Favicon.astro';
import baseStylesheets from '../data/stylesheets.json';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  bodyClass?: string;
  modifiedTime?: string;
  publishedTime?: string;
  postCss?: string;
  extraStylesheets?: string[];
}

const {
  title,
  description = 'degroteverzorginggids.nl',
  canonical = '/',
  ogImage = '',
  bodyClass = 'wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-default elementor-kit-7',
  modifiedTime = '',
  publishedTime = '',
  postCss = '',
  extraStylesheets = [],
} = Astro.props;

const pageCss = postCss ? [`/css/elementor/${postCss}`] : [];
const stylesheets = [
  ...baseStylesheets,
  ...pageCss.filter((href) => !baseStylesheets.includes(href)),
  ...extraStylesheets.filter((href) => !baseStylesheets.includes(href)),
];

const canonicalUrl = canonical.startsWith('http')
  ? canonical
  : `https://degroteverzorginggids.nl${canonical.startsWith('/') ? canonical : `/${canonical}`}`;
---

<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="degroteverzorginggids.nl" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogImage && <meta property="og:image" content={`https://degroteverzorginggids.nl${ogImage}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <Favicon />
    <link rel="preload" href="/fonts/fontawesome/fa-brands-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/eicons/eicons.woff2" as="font" type="font/woff2" crossorigin />
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link screen-reader-text" href="#content">Ga naar de inhoud</a>
    <slot />
    <script src="/js/homepage.js" defer></script>
    <script src="/js/search-form.js" defer></script>
  </body>
</html>
