---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  bodyClass: string;
  modifiedTime?: string;
  publishedTime?: string;
  postCss?: string;
}

const props = Astro.props;
---

<PageLayout
  {...props}
  extraStylesheets={['/css/product-page-fixes.css', '/css/product-accordion.css']}
>
  <slot />
  <script src="/js/product-page.js" defer></script>
</PageLayout>
